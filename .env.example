# Works without an API key in deterministic demonstration mode:
AGENT_PROVIDER=mock
AGENT_MODEL=demo
AGENT_MAX_STEPS=6
AGENT_TIMEOUT_SEC=10

# GigaChat real API: pip install -e ".[gigachat]"
# AGENT_PROVIDER=gigachat
# AGENT_MODEL=GigaChat
# GIGACHAT_CREDENTIALS=put_your_auth_key_here
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Configure trusted CA certs according to GigaChat documentation.

# OpenAI-compatible API: pip install -e ".[openai]"
# AGENT_PROVIDER=openai
# AGENT_MODEL=gpt-4o-mini
# OPENAI_API_KEY=put_your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
